<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:notatnik"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="notatnik.MainWindow"
        x:DataType="local:MainWindow"
        Title="Notatnik"
        Width="1000"
        Height="680"
        MinWidth="760"
        MinHeight="540"
        Background="#F4F6FA"
        FontFamily="Inter, Segoe UI, sans-serif">
    <Grid RowDefinitions="Auto,*" Margin="36">
        <StackPanel Spacing="6" Margin="0,0,0,28">
            <TextBlock Text="Mój notatnik" FontSize="30" FontWeight="Bold" Foreground="#172033"/>
            <TextBlock Text="Zapisuj pomysły i wracaj do nich, kiedy tylko chcesz."
                       FontSize="14" Foreground="#68738A"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="22">
            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="26">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
                    <TextBlock Text="Nowa notatka" FontSize="19" FontWeight="SemiBold" Foreground="#172033"/>

                    <TextBlock Grid.Row="1" Text="TYTUŁ" FontSize="11" FontWeight="Bold"
                               Foreground="#68738A" LetterSpacing="1"/>
                    <TextBox x:Name="TitleInput" Grid.Row="2" PlaceholderText="np. Pomysł na weekend"
                             Padding="12" FontSize="14" BorderBrush="#DDE2EC"
                             Background="#FBFCFE" CornerRadius="8"/>

                    <TextBlock Grid.Row="3" Text="TREŚĆ" FontSize="11" FontWeight="Bold"
                               Foreground="#68738A" LetterSpacing="1"/>
                    <TextBox x:Name="ContentInput" Grid.Row="4" PlaceholderText="Zacznij pisać..."
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             Padding="12" FontSize="14" BorderBrush="#DDE2EC"
                             Background="#FBFCFE" CornerRadius="8"/>

                    <Button Grid.Row="5" Content="Zapisz notatkę" Click="SaveNote_Click"
                            HorizontalAlignment="Left" Padding="20,11" CornerRadius="8"
                            Background="#4257D6" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Grid.Row="6" FontSize="12"
                               Foreground="#68738A" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="26">
                <Grid RowDefinitions="Auto,*,Auto,1.2*">
                    <DockPanel Margin="0,0,0,18">
                        <TextBlock Text="Zapisane notatki" FontSize="19" FontWeight="SemiBold"
                                   Foreground="#172033"/>
                        <Border DockPanel.Dock="Right" Background="#EEF0FF" CornerRadius="12"
                                Padding="9,3" VerticalAlignment="Center">
                            <TextBlock x:Name="NoteCount" Text="0" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#4257D6"/>
                        </Border>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="NotesList" ItemsSource="{Binding Notes}"
                                 SelectionChanged="NotesList_SelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0" Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:Note">
                                    <Border Background="#F8F9FC" CornerRadius="10" Padding="14"
                                            Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15"
                                                       FontWeight="SemiBold" Foreground="#172033"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DateLabel}"
                                                       FontSize="11" Foreground="#8A93A5"
                                                       Margin="10,2,0,0"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="EmptyNotes" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="Jeszcze tu pusto" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#68738A" HorizontalAlignment="Center"/>
                            <TextBlock Text="Twoje zapisane notatki pojawią się w tym miejscu."
                                       FontSize="12" Foreground="#8A93A5" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="220"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Treść notatki" FontSize="15"
                               FontWeight="SemiBold" Foreground="#172033"
                               Margin="0,16,0,10"/>
                    <Grid Grid.Row="3">
                        <ScrollViewer x:Name="SelectedNoteViewer" IsVisible="False"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="SelectedNoteContent" FontSize="13"
                                       Foreground="#68738A" TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <TextBlock x:Name="SelectNoteHint" Text="Wybierz notatkę, aby wyświetlić jej treść."
                                   FontSize="12" Foreground="#8A93A5" TextWrapping="Wrap"
                                   VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
